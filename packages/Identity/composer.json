{
  "name": "fluxio/identity",
  "description": "Identity and authentication module for Fluxio",
  "version": "0.1.0",
  "type": "library",
  "autoload": {
    "psr-4": { "Fluxio\\Identity\\": "src/" }
  },
  "extra": {
